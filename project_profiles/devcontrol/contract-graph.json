    "release_orchestrator": {"paths": ["scripts/deploy_production.sh", "scripts/check_release_pipeline_contract.sh", "scripts/test_server_package.sh"], "contracts": ["release-qualification", "deployment-binding"], "artifacts": ["release-evidence"]}
